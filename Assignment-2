import time

# Original recursive method
def ways_naive(n):
    if n <= 1:
        return 1
    return ways_naive(n - 1) + ways_naive(n - 2)


# Optimised iterative method
def ways_optimised(n):
    if n <= 1:
        return 1

    previous_two = 1
    previous_one = 1

    for step in range(2, n + 1):
        current = previous_one + previous_two
        previous_two = previous_one
        previous_one = current

    return previous_one


# Validate both methods for inputs from 1 to 30
for n in range(1, 31):
    assert ways_naive(n) == ways_optimised(n)

print("Validation passed for n = 1 to 30")


# Compare execution time for n = 10, 20, 30
for n in [10, 20, 30]:

    start = time.perf_counter()
    original = ways_naive(n)
    original_time = time.perf_counter() - start

    start = time.perf_counter()
    redesigned = ways_optimised(n)
    redesigned_time = time.perf_counter() - start

    print("\nn =", n)
    print("Same answer:", original == redesigned)
    print("Original time:", original_time)
    print("Redesigned time:", redesigned_time)


# Large input using optimised method
large_answer = ways_optimised(1000)

print("\nn = 1000 completed.")
print("Number of digits:", len(str(large_answer)))
