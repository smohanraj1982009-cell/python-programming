import random
import string
import time


# Normalize phone numbers
def normalise_phone(phone):
    digits = "".join(ch for ch in (phone or "") if ch.isdigit())

    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    return digits


# Normalize names
def normalise_name(name):
    return " ".join((name or "").lower().split())


# Merge duplicate contacts
def merge_contacts(records):
    merged = {}

    for record in records:
        name = record.get("name", "").strip()
        phone = record.get("phone", "")
        email = record.get("email", "").strip().lower()

        normal_phone = normalise_phone(phone)

        if normal_phone:
            key = ("phone", normal_phone)
        else:
            key = ("fallback", normalise_name(name), email)

        if key not in merged:
            merged[key] = {
                "name": name,
                "phones": set(),
                "emails": set()
            }

        if name and not merged[key]["name"]:
            merged[key]["name"] = name

        if normal_phone:
            merged[key]["phones"].add(normal_phone)

        if email:
            merged[key]["emails"].add(email)

    return merged


