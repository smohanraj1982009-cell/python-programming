def compile_fest(folder, departments=DEPARTMENTS):
    """Compile all department files in `folder`; returns a CompileResult."""
    folder = Path(folder)
    folder.mkdir(parents=True, exist_ok=True)
    result = CompileResult()

    for dept in departments:
        path = folder / f"{dept}.txt"
        if not path.exists():
            result.errors.append((str(path), 0, "missing department file"))
            continue
        _parse_file(path, result)

    _write_outputs(folder, result)
    return result


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    folder = argv[0] if argv else "department_files"
    r = compile_fest(folder)
    print(f"Unique: {len(r.master)}, Events: {len(r.event_groups)}, "
          f"Errors: {len(r.errors)}, Duplicates: {len(r.duplicates)}")


if __name__ == "__main__":
    main()
